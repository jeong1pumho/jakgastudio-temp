{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/books",
      "destination": "/api/news?_route=books"
    },
    {
      "source": "/",
      "destination": "/api/news?_route=home"
    },
    {
      "source": "/books",
      "destination": "/api/news?_route=home&page=books"
    },
    {
      "source": "/books/:id",
      "destination": "/api/news?_route=home&page=books&book=:id"
    },
    {
      "source": "/space",
      "destination": "/api/news?_route=home&page=space"
    },
    {
      "source": "/programs",
      "destination": "/api/news?_route=home&page=programs"
    },
    {
      "source": "/visit",
      "destination": "/api/news?_route=home&page=visit"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/news",
      "destination": "/api/archive-page"
    },
    {
      "source": "/news/:slug",
      "destination": "/api/news-page"
    },
    {
      "source": "/calendar",
      "destination": "/api/news?_route=home&page=calendar"
    },
    {
      "source": "/calendar/events/:id",
      "destination": "/api/calendar-page?event_id=:id"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "functions": {
    "api/news.js": {
      "includeFiles": "lib/*.html"
    }
  }
}
