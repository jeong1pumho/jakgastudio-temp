{
  "version": 2,
  "rewrites": [
    {
      "source": "/news",
      "destination": "/api/news-page"
    },
    {
      "source": "/news/:slug",
      "destination": "/api/news-page"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}