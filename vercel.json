{
  "version": 2,
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/news",
      "destination": "/api/archive-page"
    },
    {
      "source": "/news/:slug",
      "destination": "/api/news-page"
    },
    {
      "source": "/calendar",
      "destination": "/api/calendar-page"
    },
    {
      "source": "/calendar/events/:id",
      "destination": "/api/calendar-page?event_id=:id"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
